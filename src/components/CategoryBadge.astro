---
import { CATEGORY_META, type Category } from '../consts';

interface Props {
  category: Category;
}

const { category } = Astro.props;

// Full class strings so Tailwind generates them. Each category gets its own
// restrained accent, all kept within the navy and blue palette family.
const tone: Record<Category, string> = {
  research: 'border-volt-500/30 bg-volt-500/10 text-volt-300',
  cve: 'border-sky-400/30 bg-sky-400/10 text-sky-300',
  malware: 'border-rose-400/30 bg-rose-400/10 text-rose-300',
  'threat-actors': 'border-violet-400/30 bg-violet-400/10 text-violet-300',
  exploits: 'border-teal-400/30 bg-teal-400/10 text-teal-300',
};
---

<span
  class:list={[
    'inline-flex items-center rounded-full border px-2.5 py-0.5 text-[0.68rem] font-semibold uppercase tracking-[0.12em]',
    tone[category],
  ]}
>
  {CATEGORY_META[category].label}
</span>
