---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<aside
  class:list={[
    'flex items-start gap-3 rounded-2xl border border-amber-400/25 bg-amber-400/[0.07] p-4 text-sm leading-relaxed text-amber-100/90',
    className,
  ]}
  aria-label="Sample content notice"
>
  <span class="mt-0.5 text-amber-300" aria-hidden="true">
    <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M8.26 3.1a1.9 1.9 0 0 1 3.48 0l6.3 11.8A1.9 1.9 0 0 1 16.3 17.7H3.7a1.9 1.9 0 0 1-1.74-2.8l6.3-11.8ZM10 6.5a.9.9 0 0 0-.9.9v3.4a.9.9 0 0 0 1.8 0V7.4a.9.9 0 0 0-.9-.9Zm0 7.2a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" /></svg>
  </span>
  <p>
    <strong class="font-semibold text-amber-100">Sample content.</strong> This article is demonstration material for
    the site's structure and layout. It is not a report of real incidents, measurements or actors, and must not be
    cited as research.
  </p>
</aside>
