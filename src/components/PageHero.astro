---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  /** Optional small line under the description, e.g. a "last updated" note. */
  note?: string;
}

const { eyebrow, title, description, note } = Astro.props;
---

<section class="relative isolate overflow-hidden">
  <div class="pointer-events-none absolute inset-x-0 -top-10 -z-10 h-full grid-bg opacity-70" aria-hidden="true"></div>
  <div class="mx-auto max-w-7xl px-4 pb-12 pt-16 sm:px-6 sm:pt-24 lg:px-8">
    {eyebrow && <p class="reveal text-xs font-medium uppercase tracking-[0.18em] text-volt-300">{eyebrow}</p>}
    <h1 class="reveal mt-4 max-w-4xl text-4xl font-semibold leading-[1.08] tracking-tight sm:text-6xl" style="animation-delay: 80ms">
      {title}
    </h1>
    <p class="reveal mt-6 max-w-2xl text-base leading-relaxed text-mist-300 sm:text-lg" style="animation-delay: 160ms">
      {description}
    </p>
    {note && <p class="reveal mt-4 text-sm text-mist-500" style="animation-delay: 220ms">{note}</p>}
  </div>
</section>
