---
import PageHero from './PageHero.astro';
import ArticleCard from './ArticleCard.astro';
import DemoNotice from './DemoNotice.astro';
import type { Article } from '../lib/articles';
import type { Category } from '../consts';
import { CATEGORY_META } from '../consts';

interface Props {
  category: Category;
  articles: Article[];
  description: string;
}

const { category, articles, description } = Astro.props;
const meta = CATEGORY_META[category];
const hasDemo = articles.some((article) => article.data.demo);
---

<PageHero eyebrow="Category" title={meta.label} description={description} />

<section class="mx-auto max-w-7xl px-4 pb-24 sm:px-6 lg:px-8">
  {hasDemo && <DemoNotice class="mb-8" />}

  {
    articles.length > 0 ? (
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {articles.map((article) => (
          <ArticleCard article={article} />
        ))}
      </div>
    ) : (
      <div class="glass rounded-3xl p-10 text-center">
        <p class="text-lg font-semibold text-white">No articles in this category yet.</p>
        <p class="mt-2 text-sm text-mist-400">Published entries will appear here once they are added to the content folder.</p>
      </div>
    )
  }
</section>
