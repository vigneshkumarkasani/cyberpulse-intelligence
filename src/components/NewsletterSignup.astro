<!--
  PLACEHOLDER ONLY. This form is not connected to any email service.
  Submitting it does nothing except show a notice. When a provider is chosen,
  replace the inline script and set `action` to the provider's endpoint.
  Never put provider API keys in this file.
-->
<section aria-labelledby="newsletter-heading" class="relative overflow-hidden rounded-3xl border border-volt-500/25 bg-linear-to-br from-volt-500/15 via-ink-800 to-ink-900 p-8 sm:p-10">
  <div class="pointer-events-none absolute -bottom-32 -left-20 h-80 w-80 glow-blue" aria-hidden="true"></div>
  <div class="relative grid gap-8 lg:grid-cols-2 lg:items-center">
    <div>
      <span class="inline-flex items-center rounded-full border border-amber-400/30 bg-amber-400/10 px-3 py-1 text-xs font-medium text-amber-200">
        Not yet connected
      </span>
      <h2 id="newsletter-heading" class="mt-4 text-2xl font-semibold tracking-tight">Get new research by email</h2>
      <p class="mt-3 text-sm leading-relaxed text-mist-300">
        A newsletter is planned, but no mailing list or email provider is configured yet. Signing up here will not
        store your address or send anything.
      </p>
    </div>

    <form id="newsletter-form" class="flex flex-col gap-3 sm:flex-row" novalidate>
      <label class="sr-only" for="newsletter-email">Email address</label>
      <input
        id="newsletter-email"
        name="email"
        type="email"
        autocomplete="email"
        placeholder="you@example.com"
        disabled
        class="min-w-0 flex-1 rounded-xl border border-white/10 bg-ink-950/70 px-4 py-3 text-sm text-mist-100 placeholder:text-mist-500 disabled:cursor-not-allowed disabled:opacity-60"
      />
      <button
        type="submit"
        disabled
        class="cursor-not-allowed rounded-xl bg-volt-500/40 px-5 py-3 text-sm font-semibold text-white/70"
      >
        Subscribe (coming soon)
      </button>
    </form>
    <p id="newsletter-status" class="text-xs text-mist-500 lg:col-span-2" role="status">
      Subscriptions are disabled until a provider is connected.
    </p>
  </div>
</section>
