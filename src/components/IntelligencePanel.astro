---
import DataBadge from './DataBadge.astro';
import { CATEGORIES, CATEGORY_META } from '../consts';

interface Props {
  /** Article count per category, from the sample corpus only. */
  counts: Record<string, number>;
}

const { counts } = Astro.props;
const maxCount = Math.max(1, ...Object.values(counts));

const sources = [
  { name: 'CVE records', detail: 'Published vulnerability identifiers and affected products' },
  { name: 'Exploitation signals', detail: 'Vendor and government reports of exploitation in the wild' },
  { name: 'Threat activity', detail: 'Observed campaigns and actor activity from reporting' },
];
---

<section aria-labelledby="intelligence-heading" class="relative overflow-hidden rounded-3xl border border-white/[0.08] bg-ink-900/70 p-6 sm:p-10">
  <div class="pointer-events-none absolute inset-0 grid-bg opacity-40" aria-hidden="true"></div>

  <div class="relative grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:items-start">
    <div>
      <p class="text-xs font-medium uppercase tracking-[0.18em] text-volt-300">Intelligence</p>
      <h2 id="intelligence-heading" class="mt-3 text-2xl font-semibold tracking-tight sm:text-3xl">CVE intelligence statistics</h2>
      <p class="mt-4 max-w-prose text-sm leading-relaxed text-mist-300">
        This area is reserved for vulnerability statistics once a data source is connected. Until then, no figures
        are shown here. Nothing on this page is live data.
      </p>

      <ul class="mt-8 divide-y divide-white/[0.06] rounded-2xl border border-white/[0.06] bg-ink-950/50">
        {
          sources.map((source) => (
            <li class="flex flex-col gap-2 p-4 sm:flex-row sm:items-start sm:justify-between sm:gap-6">
              <div>
                <p class="text-sm font-semibold text-white">{source.name}</p>
                <p class="mt-1 text-xs leading-relaxed text-mist-400">{source.detail}</p>
              </div>
              <DataBadge kind="pending" />
            </li>
          ))
        }
      </ul>
    </div>

    <div class="space-y-8">
      <div class="rounded-2xl border border-dashed border-white/15 bg-ink-950/60 p-5">
        <div class="flex items-center justify-between gap-3">
          <p class="text-sm font-semibold text-mist-100">Live CVE trend</p>
          <DataBadge kind="pending" />
        </div>
        <div class="relative mt-6 h-40 rounded-xl bg-[linear-gradient(to_right,rgb(255_255_255/0.04)_1px,transparent_1px),linear-gradient(to_bottom,rgb(255_255_255/0.04)_1px,transparent_1px)] bg-[length:40px_40px]">
          <div class="absolute inset-0 flex items-center justify-center p-6 text-center">
            <p class="max-w-xs text-xs leading-relaxed text-mist-500">
              Awaiting a connected data source. The chart will plot real values here, and no values are shown until then.
            </p>
          </div>
        </div>
      </div>

      <div>
        <div class="flex items-center justify-between gap-3">
          <p class="text-sm font-semibold text-mist-100">Articles per category</p>
          <DataBadge kind="demo" />
        </div>
        <p class="mt-1 text-xs text-mist-500">Counts the sample articles in this repository. These are not threat statistics.</p>
        <ul class="mt-5 space-y-3">
          {
            CATEGORIES.map((category) => {
              const count = counts[category] ?? 0;
              return (
                <li class="grid grid-cols-[9.5rem_1fr_2rem] items-center gap-3 text-xs sm:grid-cols-[11rem_1fr_2.5rem]">
                  <span class="truncate text-mist-300">{CATEGORY_META[category].label}</span>
                  <span class="h-2 overflow-hidden rounded-full bg-white/[0.06]" aria-hidden="true">
                    <span class="block h-full rounded-full bg-gradient-to-r from-volt-600 to-volt-300" style={`width: ${(count / maxCount) * 100}%`}></span>
                  </span>
                  <span class="text-right font-mono tabular-nums text-mist-200">{count}</span>
                </li>
              );
            })
          }
        </ul>
      </div>
    </div>
  </div>
</section>
