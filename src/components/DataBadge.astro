---
interface Props {
  /**
   * demo: sample content committed to this repository (not real data)
   * live: data pulled from a connected source (none is connected yet)
   * pending: a data source that is planned but not connected
   */
  kind: 'demo' | 'live' | 'pending';
}

const { kind } = Astro.props;

const labels = {
  demo: 'Demonstration data',
  live: 'Live data',
  pending: 'Not connected',
};

const tone = {
  demo: 'border-amber-400/30 bg-amber-400/10 text-amber-200',
  live: 'border-emerald-400/30 bg-emerald-400/10 text-emerald-200',
  pending: 'border-white/10 bg-white/[0.04] text-mist-400',
};

const dot = {
  demo: 'bg-amber-300',
  live: 'bg-emerald-300',
  pending: 'bg-mist-500',
};
---

<span class:list={['inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-[0.68rem] font-medium uppercase tracking-wider', tone[kind]]}>
  <span class:list={['h-1.5 w-1.5 rounded-full', dot[kind]]} aria-hidden="true"></span>
  {labels[kind]}
</span>
